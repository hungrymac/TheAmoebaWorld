# Portal (Next.js) — copy to apps/portal/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key — safe for browser with RLS enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: dashboard links to sibling apps (defaults to localhost:3001 / 3002)
NEXT_PUBLIC_MEETING_APP_URL=http://localhost:3001
NEXT_PUBLIC_ACCOUNTING_APP_URL=http://localhost:3002

# Server-only: Postgres connection for Drizzle migrations / server queries (use pooler in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
