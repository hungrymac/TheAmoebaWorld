# Portal (Next.js) — copy to apps/portal/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key — safe for browser with RLS enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: Postgres connection for Drizzle migrations / server queries (use pooler in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
